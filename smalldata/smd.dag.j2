!LUTE_DAG
# SmallData on every run; each analyzer in `analyses` only on runs whose run_type is
# DATA. One producer feeds them all: two workflows would write the same HDF5 twice.
# hutch-lute dags adds account/partition/reservation.
- !branch_daq2
$% for daq, producer in (("daq2", "SmallDataProducer2"), ("daq1", "SmallDataProducer")) %
  ${{ daq }}:
    task_name: "${{ producer }}"
    slurm_params: "${{ slurm.smd }}"
    next:
$% for a in analyses %
    - !run_type
      DATA:
        task_name: "SmallData${{ a | upper }}Analyzer"
        slurm_params: "${{ slurm.analyzer }}"
        next: []
$% endfor %
$% endfor %
