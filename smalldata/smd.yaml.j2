%YAML 1.3
---
title: "${{ experiment }} SmallData ${{ analyses | join('+') }}"
experiment: ${{ experiment }}
run: "{{ $RUN_NUM }}"
date: "${{ date }}"
lute_version: ${{ lute_version }}
task_timeout: 3600
work_dir: ${{ work_dir }}
---
SubmitSMD:
  # Explicit because pip venvs (lute: release) carry no psana to auto-detect these.
  producer: "${{ smalldata_tools }}/lcls2_producers/smd_producer.py"
  lute_template_cfg:
    template_name: "smd2_prod_config_template.py"
    output_path: "{{ work_dir }}/smalldata_tools/prod_config.py"
  directory: "${{ smd_dir }}"
  producer_parameters:
$% if 'xss' in analyses %
    # XSSAnalyzer reads <det>/pyfai_azav, so q units are required, not 2th_deg.
    getAzIntPyFAIParams:
      ${{ xss_det }}:
        poni_file: "${{ poni_file }}"
        npts: 512
        npts_az: 1
        int_units: "q_A^-1"
$% endif %
$% if 'xas' in analyses or 'xes' in analyses %
    getROIs:
$% if 'xas' in analyses %
      # XASAnalyzer reads <det>/ROI_0_sum: the first ROI is the one used.
      ${{ xas_det }}:
        - ROI: ${{ xas_roi }}
$% endif %
$% if 'xes' in analyses %
      # XESAnalyzer projects <det>/ROI_0_area: writeArea is mandatory.
      ${{ xes_det }}:
        - ROI: ${{ xes_roi }}
          writeArea: true
$% endif %
$% endif %
$% if epics_pvs %
    # PVs not saved here cannot be recovered after the run.
    epicsArchFilePV: ${{ epics_pvs }}
$% endif %
$% if 'xss' in analyses %

AnalyzeSmallDataXSS:
  xss_detname: "${{ xss_det }}"
  ipm_var: "${{ ipm_var }}"
$% if scan_var %
  scan_var: "${{ scan_var }}"
$% endif %
$% endif %
$% if 'xas' in analyses %

AnalyzeSmallDataXAS:
  xas_detname: "${{ xas_det }}"
  ipm_var: "${{ ipm_var }}"
  ccm: "${{ ccm }}"
$% if scan_var %
  scan_var: "${{ scan_var }}"
$% endif %
$% endif %
$% if 'xes' in analyses %

AnalyzeSmallDataXES:
  xes_detname: "${{ xes_det }}"
  ipm_var: "${{ ipm_var }}"
$% if scan_var %
  scan_var: "${{ scan_var }}"
$% endif %
$% endif %
