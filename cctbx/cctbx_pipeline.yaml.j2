%YAML 1.3
---
# From psagents/setup-cctbx-pipeline@baa3a20, rendered by hutch-lute render
# Experiment: ${{ experiment }}
# Rendered: ${{ date }}
title: "${{ experiment }} CCTBX SFX pipeline"
experiment: ${{ experiment }}
run: "{{ $RUN_NUM }}"
date: "${{ date }}"
lute_version: 0.2.0
task_timeout: 14400
work_dir: ${{ work_dir }}
...
---
IndexCCTBXXFEL:
  # Per-run phil file — avoids race condition when parallel runs share work_dir
  phil_file: "{{ work_dir }}/r{{ run:04d }}/cctbx_index.phil"
  # Per-run locator file — written to run subdir instead of work_dir root
  in_file: "{{ work_dir }}/r{{ run:04d }}/data_${{ experiment }}_{{ run }}.loc"
  # psana2 locator: written from data_spec keys below
  data_spec:
    experiment: "{{ experiment }}"
    run: "{{ run }}"
    detector_address: "${{ detector_address }}"
$% if wavelength_offset %
    wavelength_offset: ${{ wavelength_offset }}
    spectrum_eV_per_pixel: ${{ spectrum_eV_per_pixel }}
    spectrum_eV_offset: ${{ spectrum_eV_offset }}
$% endif %
  phil_parameters:
    # Geometry
    input_reference_geometry: "${{ geometry_file }}"
    # Output — logs in separate subdir to avoid GPFS contention with .expt/.refl
    output_output_dir: "{{ work_dir }}/r{{ run:04d }}/index"
    output_logging_dir: "{{ work_dir }}/r{{ run:04d }}/index/logs"
    output_composite_output: true
    # Dispatch
    dispatch_index: true
    dispatch_integrate: true
    dispatch_hit_finder_minimum_number_of_reflections: 40
    # Spotfinding — sigma_bkgnd=25/global_threshold=100 tuned for MFX/jungfrau
    # Update two_theta_low/high in radial_average for other instruments
    spotfinder_lookup_mask: "${{ mask_file }}"
    spotfinder_threshold_algorithm: "dispersion"
    spotfinder_threshold_dispersion_sigma_bkgnd: 25.0
    spotfinder_threshold_dispersion_global_threshold: 100
    spotfinder_filter_min_spot_size: 2
    spotfinder_filter_max_spot_size: 100
    # Indexing — unit_cell and space_group from PDB CRYST1 record
    indexing_known_symmetry_space_group: "${{ space_group }}"
    indexing_known_symmetry_unit_cell: "${{ unit_cell }}"
    indexing_refinement_protocol_d_min_start: 2
    indexing_multiple_lattice_search_max_lattices: 3
    # Integration
    integration_lookup_mask: "${{ mask_file }}"
    # Radial average (MFX/jungfrau — update two_theta range for other instruments)
    radial_average_enable: true
    radial_average_two_theta_low: 12.5
    radial_average_two_theta_high: 22.8
    radial_average_verbose: false
    radial_average_output_bins: false
    radial_average_show_plots: false
    radial_average_mask: "${{ mask_file }}"
    # MPI
    mp_method: "mpi"

ScaleCCTBXXFEL:
  # Per-run phil file — avoids race condition when parallel runs share work_dir
  phil_file: "{{ work_dir }}/r{{ run:04d }}/cctbx_scale.phil"
  # input_path points to IndexCCTBXXFEL composite output (*_integrated.expt/refl)
  # output_output_dir stored in LUTE DB so CCTBXMerger resolves it via tag/sample
  phil_parameters:
    input_path: "{{ work_dir }}/r{{ run:04d }}/index"
    scaling_model: "${{ pdb_file }}"
    merging_d_min: ${{ d_min }}
    merging_merge_anomalous: true
    output_output_dir: "{{ work_dir }}/r{{ run:04d }}/scale"
    output_prefix: "scale_r{{ run:04d }}"
    output_save_experiments_and_reflections: true
    filter_algorithm: "unit_cell"
    filter_unit_cell_value_relative_length_tolerance: 0.03
    filter_outlier_min_corr: -1.0
    select_algorithm: "significance_filter"
    select_significance_filter_sigma: 0.1
$% if select_min_ct %
    # Large unit cell (all dims > 100 Å) — override significance_filter defaults
    select_significance_filter_min_ct: ${{ select_min_ct }}
    select_significance_filter_max_ct: ${{ select_max_ct }}
$% endif %

MergeCCTBXXFEL:
  # tag/sample: input_path auto-resolved from LUTE DB for every run carrying that
  # eLog tag (or assigned to that eLog sample) — tag runs before firing cctbx_merge
$% if merge_version %
  # Versioned merge output (iteration ${{ merge_version }}) — one directory per merge iteration
  phil_file: "{{ work_dir }}/merge_${{ tag }}/${{ merge_version }}/cctbx_merge.phil"
$% else %
  # phil written to merge_${{ tag }}/ to keep work_dir root clean
  phil_file: "{{ work_dir }}/merge_${{ tag }}/cctbx_merge.phil"
$% endif %
  phil_parameters:
    ${{ selector }}: "${{ tag }}"
    # Scale output files are named scale_r*.expt — override cctbx default _integrated.expt
    input_experiments_suffix: ".expt"
    input_reflections_suffix: ".refl"
    # step_list excludes 'modify': scale already applied polarization correction;
    # re-running it fails because s1 column is absent from scale output .refl files
    dispatch_step_list: >-
      input model_scaling statistics_unitcell statistics_beam
      model_statistics statistics_resolution group errors_merge
      statistics_intensity merge statistics_intensity_cxi
    scaling_model: "${{ pdb_file }}"
    merging_d_min: ${{ d_min }}
    merging_merge_anomalous: true
    merging_error_model: "mm24"
    output_prefix: "merge_${{ tag }}"
$% if merge_version %
    output_output_dir: "{{ work_dir }}/merge_${{ tag }}/${{ merge_version }}"
$% else %
    output_output_dir: "{{ work_dir }}/merge_${{ tag }}"
$% endif %
    statistics_n_bins: 20
