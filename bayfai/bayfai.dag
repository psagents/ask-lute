!LUTE_DAG
# BayFAI geometry calibration on a powder (calibrant) run.
# SmallData accumulates the powder image; BayFAI fits the ring positions.
# hutch-lute dags fills in --account/--partition.
- !branch_daq2
  daq2:
    task_name: "SmallDataProducer2"
    slurm_params: "--nodes=4 --ntasks-per-node=50 --exclusive"
    next:
    - task_name: "BayFAIOptimizer2"
      slurm_params: "--nodes=1 --ntasks-per-node=120"
      next: []
  daq1:
    task_name: "SmallDataProducer"
    slurm_params: "--nodes=4 --ntasks-per-node=50 --exclusive"
    next:
    - task_name: "BayFAIOptimizer"
      slurm_params: "--nodes=1 --ntasks-per-node=120"
      next: []
