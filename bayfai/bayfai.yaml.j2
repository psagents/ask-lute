%YAML 1.3
---
title: "${{ experiment }} BayFAI geometry calibration"
experiment: ${{ experiment }}
run: "{{ $RUN_NUM }}"
date: "${{ date }}"
lute_version: ${{ lute_version }}
task_timeout: 3600
work_dir: ${{ work_dir }}
---
SubmitSMD:
  # Explicit because pip venvs (lute: release) carry no psana to auto-detect these.
  producer: "${{ smalldata_tools }}/lcls2_producers/smd_producer.py"
  lute_template_cfg:
    template_name: "smd2_prod_config_template.py"
    output_path: "{{ work_dir }}/smalldata_tools/prod_config_bayfai.py"
  # Kept apart from the experiment's main SmallData output, which this would overwrite.
  directory: "{{ work_dir }}/smd_output"
  producer_parameters:
    detSumAlgos:
      # calib_max, not calib: rings stand out in a max-projection, not a sum.
      ${{ detname }}:
        - "calib_max"

BayFAI:
  detname: "${{ detname }}"
  calibrant: "${{ calibrant }}"
  center:
    dist: ${{ dist }}
    poni1: 0.0
    poni2: 0.0
    rot1: 0.0
    rot2: 0.0
    rot3: 0.0
  bounds:
    dist: [-0.05, 0.05]
    poni1: [-0.005, 0.005]
    poni2: [-0.005, 0.005]
    rot1: [-0.1, 0.1]
    rot2: [-0.1, 0.1]
    rot3: [-0.1, 0.1]
  bo_params: {}
