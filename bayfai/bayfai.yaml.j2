%YAML 1.3
---
title: "${{ experiment }} BayFAI geometry calibration"
experiment: ${{ experiment }}
run: "{{ $RUN_NUM }}"
date: "${{ date }}"
lute_version: ${{ lute_version }}
task_timeout: 3600
work_dir: ${{ work_dir }}
---
SubmitSMD:
  # Explicit because a venv (central or pip) carries no psana to auto-detect the DAQ.
  producer: "${{ smalldata_tools }}/${{ daq }}_producers/smd_producer.py"
  lute_template_cfg:
    template_name: "smd${{ daq[-1] }}_prod_config_template.py"
    # smd_producer.py imports prod_config_<hutch>.py from its own directory; a config
    # written anywhere else is never read, and the repo default runs instead.
    output_path: "${{ smalldata_tools }}/${{ daq }}_producers/prod_config_${{ hutch }}.py"
  # Kept apart from the experiment's main SmallData output, which this would overwrite.
  directory: "{{ work_dir }}/smd_output"
  producer_parameters:
    detnames: ${{ (quads | map(attribute='detname') | list if quads is defined else [detname]) | tojson }}
    detSumAlgos:
      # calib_max, not calib: rings stand out in a max-projection, not a sum.
      all:
        - "calib_max"

{## Values from defaults/<hutch>.yaml, reviewed with the operator. No bayfai_params
    (bo_params before 0.4.0): the model's own defaults apply, whatever the version calls it. ##}
BayFAI:
  detname: "${{ detname }}"
  calibrant: "${{ calibrant }}"
$% if parallelized is defined %
  parallelized: "${{ parallelized }}"
$% endif %
  fixed: ${{ fixed | tojson }}
  center: ${{ dict(center, dist=dist | float) | tojson }}
  bounds: ${{ bounds | tojson }}
  resolutions: ${{ resolutions | tojson }}
